{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // "leadraai" matches the Worker the GitHub-linked build already deploys to.
  // Renaming would create a second Worker and strand the dashboard secrets.
  "name": "leadraai",
  // cloudflare-worker.ts wraps the generated .open-next/worker.js to add the cron handler.
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-28",
  // Required by the pg driver, node:crypto (15 call sites), and web-push.
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  "observability": {
    "enabled": true,
  },

  // Non-secret settings. Secrets (DATABASE_URL, keys, tokens) live in the
  // dashboard as type "Secret" and survive every deploy from GitHub.
  "vars": {
    "APP_URL": "https://leadraai.omar-alqaisi95.workers.dev",
  },
  // Keep plain variables added in the dashboard instead of wiping them on deploy.
  "keep_vars": true,

  // Cloudflare Email Service. SMTP cannot work here (no node:net), so the
  // four email features send through this binding instead. The sending
  // domain must be onboarded once:
  //   npx wrangler email sending enable <domain>
  // Until then sends return false and in-app notifications still work.
  "send_email": [{ "name": "EMAIL" }],

  // Hyperdrive pools Postgres connections across the whole fleet. Until the
  // config exists the app falls back to the DATABASE_URL secret (src/lib/db.ts),
  // so the first deploy needs nothing here. Create it with:
  //   npx wrangler hyperdrive create leadra-db --connection-string="$DIRECT_URL"
  // (point it at the DIRECT Neon endpoint, not the -pooler host), then
  // uncomment with the id it prints:
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "<hyperdrive-id>" },
  // ],

  // Replaces the two entries in vercel.json — and fixes their cadence: Vercel's
  // free plan capped crons at daily, which left inbound messages queued for up
  // to 24h. Workers has no such cap, so drain runs every minute and the
  // scheduled jobs hourly. Keep these expressions in sync with SCHEDULE_ROUTES
  // in cloudflare-worker.ts — the map there dispatches on them.
  "triggers": {
    "crons": ["* * * * *", "0 * * * *"],
  },
}
