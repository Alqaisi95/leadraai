# PostgreSQL
DATABASE_URL="postgresql://leadra:leadra@localhost:5432/leadra?schema=public"

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Encryption key for integration tokens (32 bytes base64) — move to a secrets manager in production
TOKEN_ENCRYPTION_KEY=

# Meta (Phase 2)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# AI provider (Phase 4)
ANTHROPIC_API_KEY=

# Protects /api/worker/* — used by the Cloudflare Cron Triggers
CRON_SECRET=

# Email (R2.3) — optional, via Resend HTTP API; without it, in-app notifications only
RESEND_API_KEY=
EMAIL_FROM="Leadra AI <no-reply@yourdomain.com>"
