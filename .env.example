# PostgreSQL
DATABASE_URL="postgresql://leadra:leadra@localhost:5432/leadra?schema=public"

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Encryption key for integration tokens (32 bytes base64) — move to a secrets manager in production
TOKEN_ENCRYPTION_KEY=

# Meta (Phase 2)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# AI provider (Phase 4)
ANTHROPIC_API_KEY=

# Serverless worker (Vercel) — random string, also set in the cron caller
CRON_SECRET=

# Error monitoring — optional; without it errors log as structured JSON to stdout
SENTRY_DSN=

# Email (R2.3) — optional; without it, in-app notifications only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Leadra AI <no-reply@yourdomain.com>"

# Web push (VAPID) — generate with: npx web-push generate-vapid-keys
# Push is simply off when these are absent; nothing else breaks.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"
